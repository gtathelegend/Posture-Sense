# PostureSense v2 Environment Configuration Example
# Copy to .env for local development or set in Render / Vercel dashboard for production.

# -----------------------------------------------------------------------------
# APPLICATION ENVIRONMENT & SECURITY (MANDATORY IN PRODUCTION)
# -----------------------------------------------------------------------------
FLASK_ENV=development # Options: development, testing, production
SECRET_KEY=dev-secret-key-change-this-in-production-environment-32bytes

# CORS Allowed Origins (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://posturesense.vercel.app

# -----------------------------------------------------------------------------
# SUPABASE DATABASE CONFIGURATION (OPTIONAL FOR LOCAL DEMO, REQUIRED FOR DB)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-role-key

# -----------------------------------------------------------------------------
# SMTP / EMAIL CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------
EMAIL_USER=notifications@posturesense.ai
EMAIL_PASSWORD=your-smtp-password-or-app-key
ADMIN_EMAIL=admin@posturesense.ai
